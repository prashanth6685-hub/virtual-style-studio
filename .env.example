# ---- Server ----
PORT=4000
# Postgres connection string. Local dev via docker-compose: postgresql://vss:vss@localhost:5432/vss
DATABASE_URL=postgresql://vss:vss@localhost:5432/vss
# Secret for signing JWT auth cookies. Generate a long random value for production.
JWT_SECRET=change-me-to-a-long-random-secret

# ---- AI provider ----
# pollinations (default, free, no key) | mock (labeled previews, offline) | gemini | replicate
AI_PROVIDER=pollinations
# Optional. Public base URL of this server (e.g. https://your-app.onrender.com).
# Only needed when a photo try-on source image is a relative /uploads/... URL and the
# provider must fetch it. When unset, the server falls back to the request's own host.
PUBLIC_BASE_URL=
# Only needed if AI_PROVIDER=gemini / replicate (stubs until you add a key)
GEMINI_API_KEY=
REPLICATE_API_TOKEN=

# ---- Uploads ----
# Directory for uploaded photos. Default: ./uploads (repo root when running locally).
# NOTE: hosting without a persistent disk (e.g. Render free) loses uploads on redeploy.
UPLOAD_DIR=

# ---- Client ----
# Allowed CORS origin for the API when the client is served separately (dev).
CLIENT_URL=http://localhost:5173
# API base URL baked into the client at build time. Leave empty for same-origin.
VITE_API_URL=
